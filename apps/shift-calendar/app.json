{
  "expo": {
    "name": "Tini Shift Calendar",
    "slug": "tini-shift-calendar",
    "scheme": "tini-shift-calendar",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.runlumi.tiniapps.shiftcalendar",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.runlumi.tiniapps.shiftcalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive-foreground.png",
        "backgroundColor": "#2349A6"
      }
    },
    "plugins": ["expo-router"],
    "platforms": ["ios", "android"]
  }
}
