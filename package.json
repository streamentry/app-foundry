{
  "name": "app-foundry",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "apps/ideas/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run start -w @foundry/starter",
    "ios": "npm run ios -w @foundry/starter",
    "android": "npm run android -w @foundry/starter",
    "shift:start": "npm run start -w @foundry/shift-calendar",
    "shift:ios": "npm run ios -w @foundry/shift-calendar",
    "shift:android": "npm run android -w @foundry/shift-calendar",
    "check": "npm run typecheck && npm run test && npm run architecture:check && npm run idea:verify",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npm run doctor --workspaces --if-present",
    "architecture:check": "node scripts/check-architecture.mjs",
    "bundle:shift": "npm run bundle -w @foundry/shift-calendar",
    "countdown-widget:start": "npm run start -w @foundry/countdown-widget",
    "medication-checklist:start": "npm run start -w @foundry/medication-checklist",
    "baby-feeding-log:start": "npm run start -w @foundry/baby-feeding-log",
    "plant-watering:start": "npm run start -w @foundry/plant-watering",
    "pet-medication:start": "npm run start -w @foundry/pet-medication",
    "mileage-log:start": "npm run start -w @foundry/mileage-log",
    "warranty-tracker:start": "npm run start -w @foundry/warranty-tracker",
    "cleaning-schedule:start": "npm run start -w @foundry/cleaning-schedule",
    "elderly-routine:start": "npm run start -w @foundry/elderly-routine",
    "bundle:portfolio": "node scripts/bundle-portfolio.mjs",
    "idea:lab": "npm run start -w @foundry/idea-lab",
    "idea:start": "node scripts/start-idea.mjs",
    "idea:verify": "node scripts/verify-idea-apps.mjs",
    "idea:smoke": "node scripts/smoke-ideas.mjs",
    "cash:start": "npm run start -w @foundry/idea-cash-float-count",
    "cash:ios": "npm run ios -w @foundry/idea-cash-float-count",
    "cash:android": "npm run android -w @foundry/idea-cash-float-count",
    "cash:test": "npm run test -w @foundry/idea-cash-float-count",
    "cash:bundle": "npm run bundle -w @foundry/idea-cash-float-count",
    "retainer:start": "npm run start -w @foundry/idea-freelance-retainer-hours",
    "retainer:ios": "npm run ios -w @foundry/idea-freelance-retainer-hours",
    "retainer:android": "npm run android -w @foundry/idea-freelance-retainer-hours",
    "retainer:test": "npm run test -w @foundry/idea-freelance-retainer-hours",
    "retainer:bundle": "npm run bundle -w @foundry/idea-freelance-retainer-hours"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0",
    "globals": "^16.0.0"
  }
}
